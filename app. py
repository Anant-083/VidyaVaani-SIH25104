from flask import Flask, render_template, request, jsonify
from groq import Groq
from langdetect import detect
from dotenv import load_dotenv
import os

load_dotenv()

app = Flask(__name__)
client = Groq(api_key=os.getenv("GROQ_API_KEY"))

conversation_history = []

def detect_language(text):
    try:
        if len(text.strip()) < 10:
            return "en"
        return detect(text)
    except:
        return "en"

def get_response(user_message):
    lang = detect_language(user_message)
    
    system_prompt = f"""You are VidyaVaani, an intelligent education assistant for Indian students.
You help with questions about admissions, scholarships, exams, colleges, courses, and career guidance.
The user is communicating in language code: '{lang}'.
Always reply in the exact same language and script as the user.
If you cannot detect the language, reply in English.
Keep answers helpful, concise and student-friendly."""

    conversation_history.append({
        "role": "user",
        "content": user_message
    })

    # Keep only last 5 exchanges to save memory
    recent_history = conversation_history[-10:]

    response = client.chat.completions.create(
        model="llama-3.3-70b-versatile",
        messages=[
            {"role": "system", "content": system_prompt},
            *recent_history
        ],
        max_tokens=500
    )

    bot_reply = response.choices[0].message.content

    conversation_history.append({
        "role": "assistant",
        "content": bot_reply
    })

    return bot_reply, lang

@app.route("/")
def index():
    return render_template("index.html")

@app.route("/chat", methods=["POST"])
def chat():
    data = request.get_json()
    user_message = data.get("message", "").strip()

    if not user_message:
        return jsonify({"error": "Empty message"}), 400

    try:
        reply, lang = get_response(user_message)
        return jsonify({
            "reply": reply,
            "lang": lang
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

if __name__ == "__main__":
    app.run(debug=True)
